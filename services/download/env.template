# Download Server 环境变量配置
# 复制此文件为 .env 并填入实际值

# ========== AWS / S3 配置 ==========
AWS_DEFAULT_REGION=ap-southeast-1
S3_BUCKET=weather-ai-models-de08370c

# ========== 下载调度配置 ==========
CHECK_INTERVAL_REALTIME=300
CHECK_INTERVAL_BACKFILL=14400
START_DATE=2025-10-01
# END_DATE defaults to yesterday if not set

# ========== JAXA 卫星数据配置 ==========
# 用于下载 Himawari-9 卫星数据
JAXA_USER=your-jaxa-username
JAXA_PASS=your-jaxa-password
