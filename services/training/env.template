# Training Server 环境变量配置
# 复制此文件为 env.sh 并填入实际值
# 加载方式: source env.sh

# ========== 邮件通知配置 ==========
# 训练完成/失败后发送邮件通知
export SENDER_EMAIL="your-email@gmail.com"
export SENDER_PASSWORD="your-gmail-app-password"
export RECIPIENT_EMAIL="recipient@example.com"
export CC_EMAILS="cc1@example.com,cc2@example.com"

# ========== 训练配置（可选）==========
EPOCHS_INITIAL=30
EPOCHS_INCREMENTAL=5
