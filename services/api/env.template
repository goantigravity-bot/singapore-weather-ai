# API Server 环境变量配置
# 复制此文件为 .env 并填入实际值
#
# 注意：FRONTEND_DIR / MONITOR_DIR / S3_BUCKET 由 systemd service 管理，
# 不要在 .env 中重复设置，否则会覆盖 systemd 的值。

# ========== AWS / S3 配置 ==========
AWS_DEFAULT_REGION=ap-southeast-1
# S3_BUCKET 由 systemd Environment 设置，此处仅供参考
# S3_BUCKET=weather-ai-models-de08370c

# ========== Geocoding 配置 ==========
# 可选值: nominatim | onemap (默认 nominatim)
GEOCODING_PROVIDER=nominatim

# OneMap API 凭据 (provider=onemap 时必填)
# 免费注册: https://www.onemap.gov.sg/apidocs/register
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# ========== Telegram 通知 ==========
# 1. 找 @BotFather → /newbot → 获取 token
# 2. 给 Bot 发消息 → 访问 https://api.telegram.org/bot<TOKEN>/getUpdates → 获取 chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=WeatherAIAlertBot

# ========== Sensor Data Sync ==========
# 从 S3 govdata 同步最近 N 天的传感器数据，用于预测
SENSOR_DAYS=14
