# API Server 环境变量配置
# 复制此文件为 .env 并填入实际值

# ========== API 配置 ==========
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_DIR=/home/ubuntu/weather-ai/frontend/dist

# ========== Geocoding 配置 ==========
# 可选值: nominatim | onemap (默认 nominatim)
GEOCODING_PROVIDER=nominatim

# OneMap API 凭据 (provider=onemap 时必填)
# 免费注册: https://www.onemap.gov.sg/apidocs/register
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
