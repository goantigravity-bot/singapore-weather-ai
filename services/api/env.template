# API Server Configuration
# Copy this file to .env and fill in actual values
#
# Note: FRONTEND_DIR / MONITOR_DIR / S3_BUCKET are managed by systemd service,
# do not set them here to avoid overriding systemd values.

# ========== AWS / S3 ==========
AWS_DEFAULT_REGION=ap-southeast-1
# S3_BUCKET is set by systemd Environment, listed here for reference only
# S3_BUCKET=weather-ai-models-gcc

# ========== Geocoding ==========
# Options: nominatim | onemap (default: nominatim)
GEOCODING_PROVIDER=nominatim

# OneMap API credentials (required when provider=onemap)
# Register at: https://www.onemap.gov.sg/apidocs/register
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# ========== Email Notification ==========
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_password
RECIPIENT_EMAIL=recipient@example.com
CC_EMAILS=cc1@example.com,cc2@example.com

# ========== Telegram Notification ==========
# 1. Find @BotFather → /newbot → get token
# 2. Send a message to Bot → visit https://api.telegram.org/bot<TOKEN>/getUpdates → get chat_id
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ========== Sensor Data Sync ==========
# Sync recent N days of sensor data from S3 govdata for prediction
SENSOR_DAYS=14

